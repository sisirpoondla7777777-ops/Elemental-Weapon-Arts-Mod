{
  "schemaVersion": 1,
  "id": "elemental-weapon-arts",
  "version": "${version}",
  "name": "Elemental Weapon Arts",
  "description": "A combat-focused elemental ability system built around six conduit weapons.",
  "authors": [
    "Sisir Poondla"
  ],
  "contact": {
    "sources": "https://github.com/sisirpoondla7777777-ops/Elemental-Weapon-Arts-Mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/elemental-weapon-arts/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "com.example.ElementalWeaponArts",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "com.example.client.ElementalWeaponArtsDataGenerator",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "elemental-weapon-arts.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}
